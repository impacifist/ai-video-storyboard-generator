# Copy to .env and fill only the providers you use. Never commit .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Enter an exact model ID available to your account and supporting structured output.
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_MODE=responses
OPENAI_OUTPUT_MODE=json_schema
# For a compatible service, enter its Base URL and supported API/output modes.
# OPENAI_API_MODE=chat_completions
# OPENAI_OUTPUT_MODE=prompt
# Optional SSE for compatible Chat Completions servers (default: false).
# OPENAI_CHAT_STREAM=true
CLAUDE_MODEL=
# Enter an installed Ollama model ID.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MAX_TOKENS=16000
# Applies to OpenAI-compatible loopback endpoints only; does not change cloud limits.
OPENAI_LOCAL_MAX_TOKENS=16000
# LM Studio: start the local Developer server and enter its model ID.
# Loopback LLM requests have no application socket timeout; long inference may wait indefinitely.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=
LMSTUDIO_OUTPUT_MODE=json_schema
# Shared reasoning + response budget. Input plus this limit must fit the loaded context.
LMSTUDIO_MAX_TOKENS=16000
# Optional: only when authentication is enabled on the LM Studio server.
LMSTUDIO_API_KEY=
